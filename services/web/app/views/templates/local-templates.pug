extends ../layout-website-redesign

block vars
	- isWebsiteRedesign = true

append css
	style.
		.templates-page {
			padding: 40px 0;
			min-height: 80vh;
		}
		.templates-page h1 {
			margin-bottom: 8px;
			font-size: 1.8rem;
		}
		.templates-page .subtitle {
			color: #666;
			margin-bottom: 32px;
		}
		.template-card {
			background: #fff;
			border: 1px solid #dde1e7;
			border-radius: 8px;
			padding: 24px;
			height: 100%;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
		}
		.template-card h5 {
			font-size: 1.1rem;
			margin-bottom: 8px;
		}
		.template-card p {
			color: #555;
			font-size: 0.9rem;
			flex-grow: 1;
			margin-bottom: 16px;
		}
		.empty-state {
			text-align: center;
			padding: 60px 0;
			color: #888;
		}

block content
	main#main-content.templates-page
		.container
			h1 Templates UNESP
			p.subtitle Selecione um template para criar um novo projeto

			if templates.length === 0
				.empty-state
					p Nenhum template disponível no momento.
			else
				.row
					each tmpl in templates
						.col-md-4.col-sm-6.mb-4
							.template-card
								div
									h5 #{tmpl.name}
									if tmpl.description
										p #{tmpl.description}
									else
										p Template LaTeX
								form(method='POST' action=`/project/new/local-template/${tmpl.id}`)
									input(name='_csrf' type='hidden' value=csrfToken)
									button.btn.btn-primary(type='submit') Usar este template
